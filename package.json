{
  "name": "nuxt-app",
  "version": "1.0.0",
  "license": "MIT",
  "author": {
    "name": "Luiz",
    "email": "lvmcs1@aluno.ifal.edu.br"
  },
  "main": "dist-electron/main.js",
  "private": true,
  "build": {
    "appId": "com.electron.ALEX_IPFS",
    "asar": false,
    "productName": "electron ipfs file uploader",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}_${version}.${ext}"
    },
    "mac": {
      "artifactName": "${productName}_${version}.${ext}",
      "target": [
        "dmg"
      ]
    },
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "extraFiles": [
      {
        "from": "resources",
        "to": "resources/downloads"
      }
    ],
    "files": [
      "build/**/*",
      "node_modules/**/*",
      ".output/**/*",
      "dist-electron"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "test": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "generate:documentation": "node assets/generateDocumentation.js",
    "list:documentation": "node assets/listDocumentation.js",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint:js": "eslint --ext \".ts,.vue\" --ignore-path .gitignore .",
    "lint:prettier": "prettier --check .",
    "lint": "yarn lint:js && yarn lint:prettier",
    "build:app": "nuxt build --prerender && electron-builder",
    "lintfix": "prettier --write --list-different . && yarn lint:js --fix"
  },
  "devDependencies": {
    "@nuxt/devtools": "latest",
    "@nuxt/test-utils": "^3.11.0",
    "@nuxtjs/eslint-config-typescript": "^12.0.0",
    "@testing-library/user-event": "^14.5.1",
    "@testing-library/vue": "^7.0.0",
    "@types/node": "^18.17.1",
    "@typescript-eslint/parser": "^6.2.1",
    "@vitest/coverage-v8": "^0.34.3",
    "@vue/test-utils": "^2.4.4",
    "electron": "^28.2.1",
    "electron-builder": "^24.12.0",
    "eslint": "^8.46.0",
    "eslint-config-prettier": "^8.9.0",
    "eslint-plugin-prettier": "^5.0.0",
    "happy-dom": "^13.3.8",
    "nuxt": "3.9.1",
    "nuxt-electron": "^0.7.0",
    "nuxt-vitest": "^0.10.4",
    "playwright-core": "^1.41.2",
    "prettier": "^3.0.0",
    "typescript": "^5.1.6",
    "unplugin-auto-import": "^0.16.7",
    "video.js": "^7.21.5",
    "vite-plugin-electron": "^0.15.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^1.2.2",
    "vitest-environment-nuxt": "^1.0.0",
    "vue-router": "^4.2.5"
  },
  "dependencies": {
    "@alkhipce/editorjs-aitext": "^1.0.3",
    "@date-io/date-fns": "^2.17.0",
    "@editorjs/attaches": "^1.3.0",
    "@editorjs/code": "^2.9.0",
    "@editorjs/delimiter": "^1.4.0",
    "@editorjs/editorjs": "^2.29.0",
    "@editorjs/embed": "^2.7.0",
    "@editorjs/header": "^2.7.0",
    "@editorjs/image": "^2.9.0",
    "@editorjs/inline-code": "^1.5.0",
    "@editorjs/link": "^2.6.2",
    "@editorjs/marker": "^1.4.0",
    "@editorjs/nested-list": "^1.4.2",
    "@editorjs/paragraph": "^2.11.3",
    "@editorjs/quote": "^2.6.0",
    "@editorjs/simple-image": "^1.6.0",
    "@editorjs/table": "^2.3.0",
    "@editorjs/warning": "^1.4.0",
    "@mdi/font": "^7.2.96",
    "@nftstorage/ipfs-cluster": "^5.0.1",
    "@nuxt/image": "^1.0.0-rc.3",
    "@nuxtjs/strapi": "^1.9.3",
    "@pinia/nuxt": "^0.4.11",
    "@postlight/parser": "^2.2.3",
    "@vee-validate/yup": "^4.11.1",
    "@vee-validate/zod": "^4.11.1",
    "adm-zip": "^0.5.12",
    "body-parser": "^1.20.2",
    "date-fns": "^2.30.0",
    "editorjs-alert": "^1.1.3",
    "editorjs-drag-drop": "^1.1.13",
    "editorjs-header-with-anchor": "^2.6.0",
    "editorjs-hyperlink": "^1.0.6",
    "editorjs-text-alignment-blocktune": "^1.0.3",
    "editorjs-undo": "^2.0.26",
    "electron-is-dev": "^3.0.1",
    "ethers": "^6.7.1",
    "express": "^4.18.2",
    "express-fileupload": "^1.4.0",
    "form-data": "^4.0.0",
    "kubo-rpc-client": "^4.1.1",
    "maska": "^2.1.10",
    "openai": "^4.37.0",
    "pinia": "^2.1.6",
    "plyr": "^3.7.8",
    "prismjs": "^1.29.0",
    "sass": "^1.64.2",
    "shepherd.js": "^11.2.0",
    "strapi-sdk-js": "^2.2.0",
    "v-viewer": "^1.6.4",
    "vee-validate": "^4.11.1",
    "videojs-vimeo-tech": "^1.0.0",
    "videojs-youtube": "^3.0.1",
    "viewerjs": "^1.11.6",
    "vite-plugin-vuetify": "^1.0.2",
    "vue-i18n": "^9.2.2",
    "vue-matomo": "^4.2.0",
    "vue-plyr": "^7.0.0",
    "vue-prism-component": "^2.0.0",
    "vuedraggable": "^4.1.0",
    "vueperslides": "^3.5.1",
    "vuetify": "^3.4.5",
    "yup": "^1.2.0"
  }
}
